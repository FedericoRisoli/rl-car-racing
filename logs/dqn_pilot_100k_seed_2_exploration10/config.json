{
    "config_version": 1,
    "algo": "dqn",
    "seed": 2,
    "run_type": "pilot",
    "tag": "exploration10",
    "target_timesteps": 100000,
    "evaluation": {
        "eval_freq": 10000,
        "eval_seeds": [
            100,
            101,
            102,
            103,
            104
        ],
        "deterministic": true
    },
    "best_model": {
        "metric": "mean_eval_reward",
        "enabled": true
    },
    "checkpoint": {
        "checkpoint_freq": 25000
    },
    "recovery": {
        "recovery_freq": 25000
    },
    "environment": {
        "env_id": "CarRacing-v2",
        "continuous": false,
        "lap_complete_percent": 0.95,
        "domain_randomize": false,
        "max_episode_steps": 1000
    },
    "model": {
        "policy": "CnnPolicy",
        "device": "cpu",
        "hyperparameters": {
            "learning_rate": 0.0001,
            "buffer_size": 10000,
            "learning_starts": 500,
            "batch_size": 32,
            "tau": 1.0,
            "gamma": 0.99,
            "train_freq": {
                "frequency": 4,
                "unit": "step"
            },
            "gradient_steps": 1,
            "optimize_memory_usage": false,
            "target_update_interval": 10000,
            "exploration_fraction": 0.1,
            "exploration_initial_eps": 1.0,
            "exploration_final_eps": 0.05,
            "max_grad_norm": 10.0
        }
    },
    "software": {
        "python": "3.11.9",
        "numpy": "1.26.4",
        "gymnasium": "0.29.0",
        "stable_baselines3": "2.3.2",
        "torch": "2.3.1+cpu"
    }
}